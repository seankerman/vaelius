{
  "permissions": {
    "deny": [
      "Read(~/.aws/credentials)",
      "Edit(~/.aws/credentials)",
      "Read(~/.aws/sso/cache/**)",
      "Edit(~/.aws/sso/cache/**)",
      "Read(~/.aws/cli/cache/**)",
      "Edit(~/.aws/cli/cache/**)",
      "Read(~/.ssh/id_*)",
      "Edit(~/.ssh/id_*)",
      "Read(~/.netrc)",
      "Edit(~/.netrc)",
      "Read(~/.git-credentials)",
      "Edit(~/.git-credentials)",
      "Read(~/.config/gh/hosts.yml)",
      "Edit(~/.config/gh/hosts.yml)",
      "Read(~/.docker/config.json)",
      "Edit(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Edit(~/.npmrc)",
      "Read(~/.pypirc)",
      "Edit(~/.pypirc)",
      "Read(~/.kube/config)",
      "Edit(~/.kube/config)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|LSP|Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "vaelius-client guardrail-check --profile standard",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
